limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=15r/s;
limit_req_zone $binary_remote_addr zone=auth_per_ip:10m rate=5r/m;

server {
    listen 80;
    server_name _;
    limit_req_status 429;
    root /usr/share/nginx/html;
    index index.html;

    location = ${APP_BASE_PATH} {
        return 308 ${APP_BASE_PATH}/;
    }

    location ~ ^(?:${APP_BASE_PATH})?${API_V1_PREFIX}/auth/login$ {
        limit_req zone=auth_per_ip burst=5 nodelay;
        rewrite ^(?:${APP_BASE_PATH})?(.+)$ $1 break;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^(?:${APP_BASE_PATH})?${API_V1_PREFIX}/auth/register$ {
        limit_req zone=auth_per_ip burst=5 nodelay;
        rewrite ^(?:${APP_BASE_PATH})?(.+)$ $1 break;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^(?:${APP_BASE_PATH})?${API_V1_PREFIX}/auth/bootstrap$ {
        limit_req zone=auth_per_ip burst=3 nodelay;
        rewrite ^(?:${APP_BASE_PATH})?(.+)$ $1 break;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^(?:${APP_BASE_PATH})?/api/ {
        limit_req zone=api_per_ip burst=30 nodelay;
        rewrite ^(?:${APP_BASE_PATH})?(.+)$ $1 break;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ${APP_BASE_PATH}/ {
        rewrite ^${APP_BASE_PATH}/(.*)$ /$1 break;
        try_files $uri $uri/ /index.html;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
